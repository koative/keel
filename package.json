{
  "name": "keel",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@hono/zod-openapi": "^1.5.2",
      "@hono/zod-validator": "^0.9.0",
      "@openrouter/ai-sdk-provider": "^3.0.0",
      "@scalar/hono-api-reference": "^0.11.13",
      "@t3-oss/env-core": "^0.13.11",
      "@tailwindcss/postcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-router": "^1.170.18",
      "@tanstack/react-router-devtools": "^1.167.0",
      "@tanstack/router-plugin": "^1.168.23",
      "@types/bun": "^1.3.14",
      "@types/node": "^22.20.1",
      "@types/pg": "^8.20.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "ai": "^7.0.58",
      "better-auth": "1.6.25",
      "dotenv": "^17.4.2",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "drizzle-zod": "^0.8.3",
      "evlog": "^2.24.0",
      "hono": "^4.12.32",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "pg": "^8.22.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "tsdown": "^0.22.14",
      "typescript": "^6.0.3",
      "vite": "^8.1.5",
      "zod": "^4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check-types test && bun run lint && bun tools/check-catalog.ts && bun tools/check-rules.ts && bun tools/check-migrations.ts",
    "check-types": "turbo run check-types",
    "db:down": "docker compose down postgres",
    "db:generate": "turbo run db:generate -F @keel/db",
    "db:migrate": "turbo run db:migrate -F @keel/db",
    "db:push": "turbo run db:push -F @keel/db",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:studio": "turbo run db:studio -F @keel/db",
    "db:test:migrate": "DATABASE_URL=$(bun tools/test-database-url.ts) turbo run db:migrate -F @keel/db",
    "db:test:push": "DATABASE_URL=$(bun tools/test-database-url.ts) turbo run db:push -F @keel/db -- --force",
    "db:test:start": "docker compose --profile test up -d postgres-test",
    "db:test:stop": "docker compose --profile test down postgres-test",
    "db:watch": "docker compose up postgres",
    "dev": "turbo run dev",
    "dev:server": "turbo run dev -F server",
    "dev:web": "turbo run dev -F web",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:up": "docker compose up -d --build",
    "fix": "ultracite fix",
    "gen:module": "bun tools/gen-module.ts",
    "lint": "ultracite check",
    "test": "turbo run test"
  },
  "dependencies": {
    "@keel/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@keel/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:",
    "ultracite": "7.9.4"
  },
  "packageManager": "bun@1.3.14"
}
