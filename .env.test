# The test environment. Committed on purpose, and the only env file in this
# repository that is.
#
# It exists because @keel/env validates its whole schema on import and both test
# suites that touch the database import it transitively — so a test run needs every
# required key, not just the two it reads. Those values used to be literals inside
# `apps/server/test-setup.ts` and copied into `packages/mail/test-setup.ts`; both
# preloads now read this file instead, so adding a key means editing one place.
#
# Nothing here is a secret and nothing here is a default. It is the fixture a test
# run is entitled to assume, which is why it can be committed: the development
# environment is `apps/server/.env`, and that one is not.

# Assigned to DATABASE_URL by both preloads, unconditionally — an integration test
# inserts and deletes rows, and doing that in the developer's dev database is a
# one-way mistake. Matches the docker-compose `postgres-test` service, which is
# tmpfs-backed and starts empty. Spelled out rather than built from
# POSTGRES_TEST_PORT because dotenv does not expand variables.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5433/keel_test

# Long enough to satisfy the schema's 32-character minimum and obviously not a
# secret. Every token a test mints is signed with it.
BETTER_AUTH_SECRET=test-secret-with-at-least-thirty-two-chars
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# `none` because a test run has no reader. The preloads also replace the drain
# outright; this keeps the two consistent for anything that reads the variable.
LOG_DRAIN=none

# `log` sends nothing. The mail suite constructs its drivers directly, so this
# only satisfies the schema.
MAIL_DRIVER=log
MAIL_FROM=Keel <onboarding@resend.dev>

# The rate-limit suite spends these budgets exactly, so they are part of the
# fixture rather than a tuning choice: raising them makes those tests slower for
# nothing, lowering them makes the burst assertions wrong.
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=60

BODY_LIMIT_BYTES=1048576
DATABASE_POOL_MAX=10
STATEMENT_TIMEOUT_MS=15000
WORKER_BATCH_SIZE=10
WORKER_POLL_MS=1000

# The shared key the webhook receiver verifies against. Must equal SECRET in
# apps/server/src/lib/webhook.fixtures.ts — deliveries in the route tests are
# signed with that constant.
WEBHOOK_SECRET=a-shared-webhook-secret
