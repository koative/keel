{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@keel/auth": "workspace:*",
    "@keel/db": "workspace:*",
    "@keel/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "evlog": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@keel/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
