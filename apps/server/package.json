{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "build:types": "tsdown -c tsdown.types.config.ts",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@keel/auth": "workspace:*",
    "@keel/contracts": "workspace:*",
    "@keel/crypto": "workspace:*",
    "@keel/db": "workspace:*",
    "@keel/env": "workspace:*",
    "@keel/http": "workspace:*",
    "@keel/mail": "workspace:*",
    "@scalar/hono-api-reference": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "evlog": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@keel/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "exports": {
    "./app-type": {
      "types": "./types/app.d.mts"
    }
  }
}
