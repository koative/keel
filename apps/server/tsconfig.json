{
  "extends": "@keel/config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strictNullChecks": true
  },
  // `types` holds this project's own emitted declarations; typechecking them
  // would make the build depend on its own output.
  "exclude": ["dist", "types"]
}
