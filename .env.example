# Copy to apps/server/.env and apps/web/.env, then fill in.
# Every key below is validated at startup by packages/env — a missing or malformed
# value fails immediately with the field name, rather than surfacing as undefined
# three layers deep.

# ── apps/server/.env ─────────────────────────────────────────────────────────

# Postgres. Matches the docker-compose `postgres` service by default.
DATABASE_URL=postgresql://postgres:password@localhost:5432/keel

# Better Auth signing secret. At least 32 characters.
#   bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
BETTER_AUTH_SECRET=

# Where the server is reachable. Must match the origin the browser calls.
BETTER_AUTH_URL=http://localhost:3000

# The single browser origin allowed to send credentialed requests.
CORS_ORIGIN=http://localhost:3001

# development | production | test. Defaults to development.
NODE_ENV=development

# ── apps/web/.env ────────────────────────────────────────────────────────────

# The server's origin. A leading-slash value is resolved against the current
# origin, which is how the Docker and Vercel deployments are wired.
VITE_SERVER_URL=http://localhost:3000

# ── Optional ─────────────────────────────────────────────────────────────────

# Redirects the integration test suites. Defaults to the docker-compose
# `postgres-test` service on 5433; tests never touch DATABASE_URL.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5433/keel_test

# Overrides the docker-compose Postgres password for both databases.
# POSTGRES_PASSWORD=password
